{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "files.associations": {
        "*.html": "html"
    },
    "html.validate.scripts": false,
    "html.validate.styles": false,
    "prettier.endOfLine": "auto",
    "htmlhint.enable": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/venv": true,
        "**/.venv": true,
        "**/__pycache__": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/venv/**": true,
        "**/.venv/**": true
    }
}